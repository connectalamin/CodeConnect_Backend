// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          Int       @id @default(autoincrement())
  email       String    @unique
  name        String?
  password    String
  posts       Post[]
  comments    Comment[]
  votes       Vote[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  image       String?   // URL to the user's profile image
  classId     String?   // Class ID of the user
  session     String?   // Session of the user (e.g., 2021-2025)
  batch       String?   // Batch of the user (e.g., 2023)
  dept        String?   // Department of the user (e.g., CSE, ICT)
  university  String?   // University name
  occupation  String?   // Current occupation of the user
  expertise   String[]  // Expertise tags (array of strings)
  karmaPoints Int       @default(0) // Karma points based on user actions
}

model Post {
  id           Int       @id @default(autoincrement())
  title        String
  content      String
  category     String
  userId       Int
  user         User      @relation(fields: [userId], references: [id])
  comments     Comment[]
  votes        Vote[]
  bestAnswer   Comment?  @relation("BestAnswer", fields: [bestAnswerId], references: [id])
  bestAnswerId Int?      @unique
  voteCount    Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Comment {
  id             Int      @id @default(autoincrement())
  content        String
  postId         Int
  userId         Int
  post           Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user           User     @relation(fields: [userId], references: [id])
  votes          Vote[]
  isBestAnswer   Boolean  @default(false)
  bestAnswerPost Post?    @relation("BestAnswer")
  voteCount      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Vote {
  id        Int      @id @default(autoincrement())
  value     Int // +1 for upvote, -1 for downvote
  postId    Int? // For question votes
  commentId Int? // For answer votes
  userId    Int
  post      Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  comment   Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])
}