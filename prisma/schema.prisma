// schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  USER
}

model User {
  id          Int       @id @default(autoincrement())
  email       String    @unique
  name        String?
  password    String
  role        UserRole  @default(USER) // Add role field with default USER
  posts       Post[]
  comments    Comment[]
  votes       Vote[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  image       String?
  classId     String?
  session     String?
  batch       String?
  dept        String?
  university  String?
  occupation  String?
  expertise   String[]
  karmaPoints Int       @default(0)
}

model Category {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  posts     Post[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Post {
  id           Int       @id @default(autoincrement())
  title        String
  content      String
  categoryId   Int // Replace category String with categoryId
  category     Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  userId       Int
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  comments     Comment[]
  votes        Vote[]
  bestAnswer   Comment?  @relation("BestAnswer", fields: [bestAnswerId], references: [id])
  bestAnswerId Int?      @unique
  voteCount    Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Comment {
  id             Int      @id @default(autoincrement())
  content        String
  postId         Int
  userId         Int
  post           Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  votes          Vote[]
  isBestAnswer   Boolean  @default(false)
  bestAnswerPost Post?    @relation("BestAnswer")
  voteCount      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Vote {
  id        Int      @id @default(autoincrement())
  value     Int
  postId    Int?
  commentId Int?
  userId    Int
  post      Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  comment   Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
